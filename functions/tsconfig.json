{
  // Type-checks the Cloudflare Pages Functions against the Workers runtime (npx tsc --noEmit -p functions/tsconfig.json).
  // The function also imports a few plain files from src/ (protocol, CMU colleges, the site address); they are
  // checked here too, so they must not use browser-only APIs.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["**/*.ts"]
}
