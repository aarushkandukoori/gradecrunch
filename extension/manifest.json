{
  "manifest_version": 3,
  "name": "GradeCrunch: Grades and QPA",
  "short_name": "GradeCrunch",
  "version": "1.1.0",
  "description": "All your CMU grades and QPA in one place. Reads Canvas, Gradescope, Autolab and SIO in your browser. No accounts, no tracking.",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open GradeCrunch", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "https://canvas.cmu.edu/*",
    "https://www.gradescope.com/*",
    "https://autolab.andrew.cmu.edu/*",
    "https://s3.andrew.cmu.edu/*"
  ],
  "optional_host_permissions": ["https://*.inscloudgate.net/*"],
  "externally_connectable": {
    "matches": ["https://grades.aarushkandukoori.com/*", "https://gradecrunch.pages.dev/*", "http://localhost/*"]
  },
  "minimum_chrome_version": "116"
}
