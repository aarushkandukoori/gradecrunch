{
  "manifest_version": 3,
  "name": "GradeCrunch: Grades and QPA",
  "short_name": "GradeCrunch",
  "version": "1.0.0",
  "description": "See all your grades and your QPA in one place. Reads your own Canvas, Gradescope and Autolab grades in your browser; nothing is sent to a server.",
  "key": "",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open GradeCrunch", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "offscreen"],
  "host_permissions": ["https://canvas.cmu.edu/*", "https://www.gradescope.com/*", "https://autolab.andrew.cmu.edu/*"],
  "externally_connectable": {
    "matches": ["https://grades.aarushkandukoori.com/*", "https://gradecrunch.pages.dev/*", "http://localhost/*"]
  },
  "minimum_chrome_version": "116"
}
